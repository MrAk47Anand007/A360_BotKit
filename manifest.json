{
  "manifest_version": 3,
  "name": "A360 BotKit",
  "version": "3.2",
  "description": "A360 Control Room tools for bot editing, folder export/import, autosave, and bulk package version updates.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_scripts/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content_scripts/page_bridge.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Anand S Kale",
  "homepage_url": "https://mrak47anand007.github.io/A360_BotKit/"
}
